{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/order_created_v1.json",
  "title": "Order Created Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "event_time",
    "ingest_time",
    "source",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": { "const": "order_created" },
    "event_time": { "type": "string", "format": "date-time" },
    "ingest_time": { "type": "string", "format": "date-time" },
    "source": { "const": "order-service" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_id",
        "user_id",
        "region",
        "channel",
        "currency",
        "total_amount",
        "items"
      ],
      "properties": {
        "order_id": { "type": "string", "minLength": 1 },
        "user_id": { "type": "string", "minLength": 1 },
        "region": {
          "enum": ["辽宁", "北京", "上海", "广东", "四川"]
        },
        "channel": {
          "enum": ["app", "web", "mini_program"]
        },
        "currency": { "const": "CNY" },
        "total_amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sku_id",
              "category",
              "quantity",
              "unit_price",
              "line_amount"
            ],
            "properties": {
              "sku_id": { "type": "string", "minLength": 1 },
              "category": { "type": "string", "minLength": 1 },
              "quantity": { "type": "integer", "minimum": 1, "maximum": 5 },
              "unit_price": {
                "type": "string",
                "pattern": "^[1-9][0-9]*\\.[0-9]{2}$"
              },
              "line_amount": {
                "type": "string",
                "pattern": "^[1-9][0-9]*\\.[0-9]{2}$"
              }
            }
          }
        }
      }
    }
  }
}

